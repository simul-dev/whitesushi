{
  "name": "floor-plan-to-3d-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "esbuild bench/src/cli.ts --bundle --platform=node --format=esm --outfile=bench/.build/cli.mjs --log-level=warning && node bench/.build/cli.mjs",
    "bench:llm": "esbuild bench/llm/agent.ts --bundle --platform=node --format=esm --packages=external --outfile=bench/.build/agent.mjs --log-level=warning && node bench/.build/agent.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  }
}
